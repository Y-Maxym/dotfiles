if command -v zsh >/dev/null 2>&1; then
    _zenv="$(zsh -ic 'source ~/.config/uwsm/zsh-env.zsh' 2>/dev/null | grep -E '^(\[ -z |export PATH=)')"
    eval "$_zenv"
    unset _zenv
fi

# Cursor theme (Bibata, Xcursor) - read by Hyprland, GTK, Qt, Xwayland apps
export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24

# Qt theme: the qt6ct plugin reads ~/.config/qt6ct (Fusion style + matugen color scheme); comment out to disable
export QT_QPA_PLATFORMTHEME=qt6ct
